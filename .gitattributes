# Store text with LF in the repository; Git converts to the platform's line
# endings on checkout. Windows scripts keep CRLF everywhere.
* text=auto
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.cs text eol=crlf

*.png binary
*.ico binary
*.gif binary
*.pfx binary
*.cer binary
*.msix binary
